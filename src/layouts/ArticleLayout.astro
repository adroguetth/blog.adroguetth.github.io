---
// ArticleLayout.astro
// Plantilla para la página de UN artículo individual.
// Muestra: categoría, título, descripción, fecha, tiempo de lectura,
// el contenido (via <slot />), y al final tags + navegación anterior/siguiente.

import BaseLayout from "./BaseLayout.astro";
import { formatDate, tagToSlug } from "../lib/utils";

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  tags: string[];
  readingTime: number;
  prevPost?: AdjacentPost | null;
  nextPost?: AdjacentPost | null;
}

const {
  title,
  description,
  category,
  date,
  tags,
  readingTime,
  prevPost = null,
  nextPost = null,
} = Astro.props;

const categorySlug = category.toLowerCase();
---

<BaseLayout title={title} description={description} ogType="article">
  <article class="prose-width article">
    <header class="article__header">
      <a href={`/${categorySlug}/`} class="eyebrow">{category}</a>
      <h1 class="article__title">{title}</h1>
      <p class="article__description">{description}</p>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        · {readingTime} min de lectura
      </p>
    </header>

    <div class="article-body">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="article__footer">
        <ul class="tag-list">
          {tags.map((tag) => (
            <li class="tag">
              <a href={`/tag/${tagToSlug(tag)}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      </footer>
    )}

    {(prevPost || nextPost) && (
      <nav class="article__pagination" aria-label="Navegación entre artículos">
        <div>
          {prevPost && (
            <a href={`/articulo/${prevPost.slug}/`} class="article__pagination-link">
              <span class="meta">← Anterior</span>
              <span>{prevPost.title}</span>
            </a>
          )}
        </div>
        <div class="article__pagination-next">
          {nextPost && (
            <a href={`/articulo/${nextPost.slug}/`} class="article__pagination-link">
              <span class="meta">Siguiente →</span>
              <span>{nextPost.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    padding: 3rem 1.5rem 2rem;
  }

  .article__header {
    margin-bottom: 2.5rem;
  }

  .article__title {
    font-size: 2rem;
    margin: 0.6rem 0 0.8rem;
  }

  .article__description {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    margin: 0 0 0.9rem;
  }

  .article__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article__pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article__pagination-next {
    text-align: right;
    margin-left: auto;
  }

  .article__pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .article__pagination-link:hover span:last-child {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .article {
      padding: 2rem 1.25rem 1.5rem;
    }
    .article__title {
      font-size: 1.6rem;
    }
    .article__pagination {
      flex-direction: column;
    }
    .article__pagination-next {
      text-align: left;
      margin-left: 0;
    }
  }
</style>
