---
// Header.astro
// Cabecera del sitio: logo + navegación. Aparece en todas las páginas
// porque se incluye desde BaseLayout.astro.
//
// Para cambiar los enlaces del menú, edita el arreglo "navLinks" de abajo.

import Search from "./Search.astro";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/tutoriales/", label: "Tutoriales" },
  { href: "/proyectos/", label: "Proyectos" },
  { href: "/investigaciones/", label: "Investigaciones" },
  { href: "/notas/", label: "Notas" },
  { href: "/archivo/", label: "Archivo" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="page site-header__inner">
    <a href="/" class="logo">adroguett.</a>

    <div class="header-search">
      <Search />
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menú de navegación"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="site-nav" class="site-nav">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="site-nav__external">
          <a href="https://adroguetth.github.io/" target="_blank" rel="noopener">
            Servicios ↗
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    flex-shrink: 0;
  }

  .header-search {
    flex: 1;
    max-width: 16rem;
    margin: 0 1.5rem;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--color-text);
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .site-nav__external a {
    color: var(--color-accent);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }

  /* ---------- MÓVIL ---------- */
  @media (max-width: 720px) {
    .nav-toggle {
      display: flex;
    }

    .header-search {
      display: none;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.5rem 1.5rem 1.25rem;
    }

    .site-nav li {
      width: 100%;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav li:last-child {
      border-bottom: none;
    }
  }
</style>

<script>
  // Muestra/oculta el menú en móvil al tocar el botón de hamburguesa.
  // Es el único JavaScript de navegación del sitio.
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
